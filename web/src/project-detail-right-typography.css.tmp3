/* Compact, aligned typography for the narrow workflow sidebar. */
.project-detail-shell .project-review-gate{display:flex;align-items:stretch;flex-direction:column;gap:10px;min-height:160px;padding:22px 22px 16px}
.project-detail-shell .project-review-gate strong{color:#30483a;font-size:.78rem;line-height:1.3}
.project-detail-shell .project-review-gate small{margin-top:4px;color:#7d8c82;font-size:.68rem;line-height:1.35}
.project-detail-shell .project-review-gate>button{width:100%;margin-top:auto;padding:8px 10px;font-size:.64rem;line-height:1.2}
.project-detail-shell .finish-proofs{top:306px;padding:20px 22px 24px;border-top:1px solid #e1e9e3}
.project-detail-shell .finish-proofs>div:first-child .eyebrow{font-size:.55rem;letter-spacing:.12em;line-height:1.2}
.project-detail-shell .finish-proofs>div:first-child h3{margin:6px 0 0;font-size:.82rem;line-height:1.25}
.project-detail-shell .finish-proofs>div:first-child p{margin:5px 0 12px;color:#7d8b82;font-size:.64rem;line-height:1.35}
.project-detail-shell .finish-proofs .proof-mode{display:flex;width:100%;margin:8px 0 12px}
.project-detail-shell .finish-proofs .proof-mode button{flex:1;min-width:0;padding:7px 5px;font-size:.58rem;line-height:1.2}
.project-detail-shell .finish-proofs .proof-upload{align-items:center;gap:8px;padding:9px}
.project-detail-shell .finish-proofs .proof-upload span{flex:0 0 auto;padding:7px 8px;font-size:.56rem;line-height:1.2}
.project-detail-shell .finish-proofs .proof-upload small{min-width:0;font-size:.58rem;line-height:1.35}
.project-detail-shell .finish-proofs .proof-list{gap:6px;margin-top:10px}
.project-detail-shell .finish-proofs .proof-list button{gap:7px;padding:8px}
.project-detail-shell .finish-proofs .proof-list strong{font-size:.58rem;line-height:1.25}
.project-detail-shell .finish-proofs .proof-list small{margin-top:2px;font-size:.5rem;line-height:1.2}
@media(max-width:900px){.project-detail-shell .project-review-gate,.project-detail-shell .finish-proofs{position:static;min-height:0;padding:22px;border-top:1px solid #e1e9e3}.project-detail-shell .project-review-gate strong{font-size:.82rem}.project-detail-shell .project-review-gate small,.project-detail-shell .finish-proofs>div:first-child p{font-size:.7rem}}
